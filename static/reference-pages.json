{"forecast": "<div class=\"flex flex-col w-full bg-surface-container-lowest text-on-surface select-none\">\n<!-- TOP TELEMETRY STRIP & CONTEXT SELECTOR -->\n<section class=\"w-full bg-surface-container-low border-b border-surface-container-high px-margin py-space-sm flex flex-col xl:flex-row xl:items-center justify-between gap-space-md\" data-slot=\"forecast-top\"></section>\n<!-- KEY METRIC HUD CARDS (4-CELL BENTO STRIP) -->\n<section class=\"w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 bg-surface-container-high gap-[1px] border-b border-surface-container-high\" data-slot=\"metrics\"></section>\n<!-- TIME-SERIES TELEMETRY VISUALIZATION BLOCK -->\n<section class=\"w-full p-margin bg-surface-container-lowest\" data-slot=\"forecast-chart\"></section>\n<!-- SKU-LEVEL DEMAND PREDICTIONS & PREP DISPATCH TABLE -->\n<section class=\"w-full px-margin pb-margin\" data-slot=\"runlist\"></section>\n<!-- KITCHEN OPERATIONS ACTION DOCK (SHARP BOTTOM SPLIT BAR) -->\n<section class=\"w-full bg-surface-container-low border-t border-surface-container-high p-space-md\" data-slot=\"forecast-actions\"></section>\n<!-- INTERACTION HOOK SCRIPT -->\n\n</div>", "upload": "<div class=\"flex flex-col w-full\">\n<!-- Top Telemetry Sub-Header & Controls -->\n<div class=\"w-full bg-surface-container-low px-margin py-space-md border-b border-surface-container-high\" data-slot=\"upload-top\"></div>\n<!-- Main Pipeline Body (Lattice Grid) -->\n<div class=\"w-full p-margin flex flex-col gap-space-lg\">\n<!-- Primary Ingestion Drag & Drop Target Box -->\n<div class=\"w-full bg-surface-container-low border border-surface-container-highest p-space-xl flex flex-col items-center justify-center text-center relative transition-colors duration-150 cursor-pointer hover:border-primary-container\" data-slot=\"upload-drop\" id=\"drop-target\"></div>\n<!-- Telemetry & Schema Validation Panel (Two Column Lattice) -->\n<div class=\"w-full grid grid-cols-1 lg:grid-cols-12 gap-space-lg\">\n<!-- File Metadata & Transfer Metrics -->\n<div class=\"lg:col-span-4 bg-surface-container-low border border-surface-container-high flex flex-col\" data-slot=\"upload-descriptor\"></div>\n<!-- Schema Alignment Matrix -->\n<div class=\"lg:col-span-8 bg-surface-container-low border border-surface-container-high flex flex-col\" data-slot=\"upload-schema\"></div>\n</div>\n<!-- Raw Data Preview Table (Dense Technical Grid) -->\n<div class=\"w-full bg-surface-container-low border border-surface-container-high flex flex-col\" data-slot=\"upload-preview\"></div>\n<!-- Ingestion Configuration & Next Action Footer Bar -->\n<div class=\"w-full bg-surface-container-low border border-surface-container-high p-space-md flex flex-col xl:flex-row xl:items-center justify-between gap-space-md\" data-slot=\"upload-actions\"></div>\n</div>\n</div>", "inventory": "<div class=\"flex flex-col w-full text-on-surface\">\n<div class=\"w-full bg-surface-container-lowest p-margin flex flex-col gap-space-lg\">\n<div class=\"flex flex-col md:flex-row md:items-end justify-between gap-space-md bg-surface-container-low p-space-lg\" data-slot=\"inventory-top\"></div>\n<div class=\"grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-gutter bg-surface-container-high\" data-slot=\"metrics\"></div>\n<div class=\"grid grid-cols-1 xl:grid-cols-12 gap-space-lg\">\n<div class=\"xl:col-span-8 flex flex-col bg-surface-container-low\" data-slot=\"inventory-grid\"></div>\n<div class=\"xl:col-span-4 flex flex-col bg-surface-container-low\" data-slot=\"inventory-manifest\"></div>\n</div>\n<div class=\"grid grid-cols-1 md:grid-cols-3 gap-gutter bg-surface-container-high\" data-slot=\"inventory-bottom\"></div>\n</div>\n\n</div>", "overview": "<div class=\"flex flex-col w-full\">\n<!-- TOP TELEMETRY STATUS RIBBON -->\n<section class=\"w-full bg-surface-container-low border-b border-surface-container-high\" data-slot=\"overview-status\"></section>\n<!-- HERO SECTION -->\n<section class=\"w-full bg-surface-container-lowest px-margin py-space-xl border-b border-surface-container-high\">\n<div class=\"max-w-[1600px] mx-auto flex flex-col gap-space-xl\">\n<!-- SYSTEM CATEGORY TICKER -->\n<div class=\"flex items-center gap-space-sm\">\n<span class=\"px-2 py-0.5 bg-surface-container border border-surface-container-highest font-label-caps text-label-caps text-primary uppercase\">[ ARCHITECTURE: WEEKDAY ENSEMBLE \u00d7 RESTAURANT SALES ]</span>\n<span class=\"hidden sm:inline-block font-label-caps text-label-caps text-outline uppercase\">REV_STAGE // INTERACTIVE DEMO</span>\n</div>\n<!-- MAMMOTH HEADLINE -->\n<div class=\"flex flex-col gap-space-md\">\n<h1 class=\"font-display text-display uppercase tracking-tight text-on-surface font-semibold max-w-5xl\">ALGORITHMIC KITCHEN DEMAND FORECASTING. SMARTER PREPARATION.</h1>\n<p class=\"font-body-lg text-body-lg text-on-surface-variant max-w-3xl leading-relaxed\">Upload historical restaurant sales. Explore dish-level demand, compare what-if scenarios, and turn forecasts into an editable kitchen preparation plan.</p>\n</div>\n<!-- DUAL SHARP CTA BAR -->\n<div class=\"flex flex-col sm:flex-row items-stretch sm:items-center gap-space-md pt-space-xs\">\n<a class=\"h-12 px-space-xl bg-primary-container text-on-surface font-label-caps text-label-caps uppercase tracking-wider border border-primary-container hover:bg-inverse-primary hover:border-inverse-primary transition-colors flex items-center justify-center gap-space-sm\" href=\"#upload\" type=\"button\">\n<span class=\"\">DEPLOY MODEL INGESTION</span>\n<span class=\"ref-icon\">\u2192</span>\n</a>\n<a class=\"h-12 px-space-xl bg-surface-container-low text-on-surface font-label-caps text-label-caps uppercase tracking-wider border border-surface-container-high hover:bg-surface-container hover:border-outline transition-colors flex items-center justify-center gap-space-sm\" href=\"#forecast\" type=\"button\">\n<span class=\"ref-icon\">\u2318</span>\n<span class=\"\">EXPLORE TELEMETRY SPEC</span>\n</a>\n<div class=\"hidden lg:flex items-center pl-space-md font-label-caps text-label-caps text-outline uppercase\">\n<span class=\"px-2 py-1 bg-surface-container-low border border-surface-container-high text-secondary\">SYNTHETIC_SALES.CSV</span>\n</div>\n</div>\n<!-- QUICK INTEGRATION STRIP -->\n<div class=\"pt-space-md border-t border-surface-container-high flex flex-col md:flex-row items-start md:items-center justify-between gap-space-sm\">\n<span class=\"font-label-caps text-label-caps text-outline uppercase tracking-widest\">INGESTION_COMPATIBILITY_MATRIX:</span>\n<div class=\"flex flex-wrap items-center gap-space-xs\">\n<span class=\"px-2 py-1 bg-surface-container border border-surface-container-high text-on-surface font-label-caps text-label-caps\">TOAST POS / PLANNED</span>\n<span class=\"px-2 py-1 bg-surface-container border border-surface-container-high text-on-surface font-label-caps text-label-caps\">SQUARE API / PLANNED</span>\n<span class=\"px-2 py-1 bg-surface-container border border-surface-container-high text-on-surface font-label-caps text-label-caps\">MICROS SIMPHONY / PLANNED</span>\n<span class=\"px-2 py-1 bg-surface-container border border-surface-container-high text-on-surface font-label-caps text-label-caps\">REVEL SYSTEMS / PLANNED</span>\n<span class=\"px-2 py-1 bg-surface-container border border-surface-container-high text-on-surface font-label-caps text-label-caps\">OLO ORDER INGEST / PLANNED</span>\n<span class=\"px-2 py-1 bg-surface-container border border-secondary/40 text-secondary font-label-caps text-label-caps\">+ CSV UPLOAD / ACTIVE</span>\n</div>\n</div>\n</div>\n</section>\n<!-- TECHNICAL TERMINAL / SHOWCASE -->\n<section class=\"w-full bg-surface-container-lowest px-margin py-space-xl border-b border-surface-container-high\" data-slot=\"overview-console\"></section>\n<!-- BENCHMARK TELEMETRY BAR -->\n<section class=\"w-full bg-surface-container border-b border-surface-container-high\" data-slot=\"metrics\"></section>\n<!-- CORE FEATURE ARCHITECTURE GRID (BRAUN / TEST BENCH VIBE) -->\n<section class=\"w-full bg-surface-container-lowest px-margin py-space-xl border-b border-surface-container-high\" data-slot=\"overview-architecture\"></section>\n<!-- RAW RUN-LIST / LIVE DATA MATRIX SECTION -->\n<section class=\"w-full bg-surface-container-lowest px-margin py-space-xl border-b border-surface-container-high\" data-slot=\"overview-runlist\"></section>\n<!-- BOTTOM CTA & SYSTEM SPEC BANNER -->\n<section class=\"w-full bg-surface-container-lowest px-margin py-space-xl\" data-slot=\"overview-cta\"></section>\n</div>"}